# Bot User OAuth Token (xoxb-...) — api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-

# App-Level Token with connections:write (xapp-...) — Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-

# Comma-separated Slack user IDs allowed to trigger runs (required, no default)
# Find yours: Slack profile > ⋯ > Copy member ID  (e.g. U0123456789)
ALLOWED_USERS=

# Parent directory that repo:<name> resolves against (default ~/code)
DEVIN_HOME=~/code

# Max concurrent devin runs (default 3)
MAX_CONCURRENT=3

# Per-run timeout in seconds (default 3600)
RUN_TIMEOUT=3600

# devin binary path if not on PATH for the launchd/headless env
# DEVIN_BIN=/opt/homebrew/bin/devin

# --- Token rotation (required if your app has token rotation enabled) ---
# OAuth & Permissions > Refresh Token, plus App Credentials on Basic Information
# Do NOT name these SLACK_CLIENT_*: bolt auto-enables OAuth mode on those env names.
# BRIDGE_CLIENT_ID=
# BRIDGE_CLIENT_SECRET=
# BRIDGE_APP_REFRESH_TOKEN=xoxe-   # refresh token for the App-Level Token
# BRIDGE_BOT_REFRESH_TOKEN=xoxe-   # refresh token for the Bot Token, if shown
